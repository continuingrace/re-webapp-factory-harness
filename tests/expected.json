      "expected_failures": [["MB-01", "MOBILE_OVERFLOW"], ["MB-05", "FONT_FALLBACK_BROKEN"]],
      "consequential": ["MB-05"],
      "note": "MB-05도 360px 화면에서 가로 넘침을 검사하므로 같은 원인으로 함께 실패한다."
    },
    "F6": { "end_to_end": false, "expected_failures": [["ST-02", "ICON_MISSING"]] },
    "F7": { "end_to_end": false, "expected_failures": [["ST-03", "SECRET_DETECTED"]], "complete_token_occurrences": 0 },
    "F8": {
