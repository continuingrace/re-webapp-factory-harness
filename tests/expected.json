      "consequential": ["JG-02"]
    },
    "F9": { "end_to_end": false, "expected_failures": [["JG-02", "PRE_RECORD_AUTHORIZATION_STALE"]] },
    "F10": { "end_to_end": false, "expected_hook_denials": 2 }
  }
