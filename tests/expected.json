      "expected_failures": [["JG-01", "UNVERIFIED_PASS"], ["JG-02", "COMPLETION_UNMET"]],
      "consequential": ["JG-02"],
      "principle": 1
    },
    "F3": { "end_to_end": false, "expected_failures": [["ST-05", "VERSION_MISMATCH"]] },
    "F4": { "end_to_end": false, "expected_failures": [["DS-01", "DESIGN_LETTER_SPACING"]] },
    "F5": {
